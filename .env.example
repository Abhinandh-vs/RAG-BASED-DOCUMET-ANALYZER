# Required: HuggingFace API token (free at https://huggingface.co/settings/tokens)
# Needs "Make calls to Inference Providers" permission
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here

# Optional: override the default LLM (default: Qwen/Qwen2.5-7B-Instruct)
# HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Optional: FAISS relevance threshold — lower = stricter matching (default: 2.0)
# RELEVANCE_THRESHOLD=2.0

# App settings
APP_ENV=development
LOG_LEVEL=info
